# Dados e outputs (ficam só no disco)
raw/
wikiart/
outputs/*
logs/

# Metadados e subconjuntos derivados localmente.  Os scripts em src/data/
# reconstroem estes artefatos; apenas metadados de fontes externas curados
# manualmente devem ser adicionados explicitamente.
data/wikiart_all_images.csv
data/wikiart_robustness*/

# Exceção: descrições geradas pelo SLM são versionadas
!outputs/slm_descriptions/

# Exceção: só o modelo final de captioning é versionado (não os checkpoints intermediários)
!outputs/caption_model/
outputs/caption_model/checkpoint-*/

# Exceção: predições do modelo de captioning são versionadas
!outputs/caption_predictions/

# Dataset COCO (cada servidor baixa sua própria cópia)
data/coco/

# Datasets ArtEmis (labels) + WikiArt (imagens) — cada servidor baixa sua cópia
data/artemis/
data/wikiart/
data/wikiart_robustness*/images/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/
.tools/

# Configuração local de assistentes/editores (não é configuração do projeto).
.claude/settings.local.json

# Jupyter
.ipynb_checkpoints/

# Arquivos temporários
*.log
nohup.out
*.tmp
*.orig
*.pdf

# Intermediários grandes de avaliação.  As tabelas resumidas, figuras e scripts
# em results/ são versionados; caches, vetores por imagem e predições OOF são
# reconstituíveis e ficam somente no disco de execução.
results/cache_*/
results/*_features.parquet
results/*_predictions.csv
results/*_sample.csv
results/*_audit.csv
results/*_permutation_raw.csv
results/*_cohort.csv
results/*_pairs.csv
results/*.npy
results/*.npz
results/.patch_probe

# image-to-text: caches e artefatos grandes regeneráveis pela pipeline
experiments/image-to-text/artifacts/clip_feats_*.npy
experiments/image-to-text/artifacts/teacher_captions*.jsonl
experiments/image-to-text/teacher_captions*.jsonl
experiments/image-to-text/artifacts/full_run/
